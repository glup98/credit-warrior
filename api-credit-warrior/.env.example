# Application Settings
APP_NAME="Credit Warrior API"
APP_ENV="development"
DEBUG=false

# Server Binding (MUST bind to 127.0.0.1 in development/testing)
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (JSON list or comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Connection (Use least-privilege DB user; never commit real credentials)
# Example for local PostgreSQL or Supabase connection pooler:
DATABASE_URL="postgresql+psycopg://credit_warrior_app:change_me_locally@127.0.0.1:5432/credit_warrior"
